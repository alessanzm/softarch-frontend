<!DOCTYPE html>
<html>
<head>
    <title>Edit Course</title>
    <link rel="stylesheet" href="style.css">
</head>

<body class="edit-course-body">

<div class="navbar">
    <h2>Edit Course</h2>
</div>

<div class="container">
    <div class="edit-course-card">

        <form action="/CourseServlet" method="post">

            <input type="hidden" name="action" value="update">
            <input type="hidden" name="courseId" value="1">

            <label>Title</label>
            <input type="text" name="title" value="Software Engineering" required>

            <label>Description</label>
            <textarea name="description" rows="5" required>
Introduction to Software Engineering concepts.
            </textarea>

            <label>Course Code</label>
            <input type="text" name="courseCode" value="CSF3433" required>

            <div class="button-group">
                <button type="submit">Update Course</button>
                <a href="course-list.html" class="edit-course-back-link">Cancel</a>
            </div>

        </form>

    </div>
</div>

</body>
</html>
